# ==============================================================================
# Modern Cloud & Domain Hosting Portal - Environment Configuration
# ==============================================================================

# Application Server
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production-2026
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# 1. Database Configuration (SQL Server & Local SQLite Fallback)
# ------------------------------------------------------------------------------
# To connect to your Microsoft SQL Server instance, update these:
DB_SERVER=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourStrongPasswordHere
DB_DATABASE=PortalDb
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# ------------------------------------------------------------------------------
# 2. Upstream W3Infotech Reseller Account (Username & Password Only)
# ------------------------------------------------------------------------------
# Set your W3Infotech Reseller login credentials here:
W3_PORTAL_URL=https://w3infotech.com
W3_RESELLER_USER=your_reseller_username_or_email@example.com
W3_RESELLER_PASSWORD=your_reseller_password_here
W3_RESELLER_CREDIT_BALANCE=25000

# ------------------------------------------------------------------------------
# 3. Server Provisioning & Hypervisor Integrations
# ------------------------------------------------------------------------------
# Plesk Obsidian API
PLESK_HOST=plesk.yourdomain.com
PLESK_PORT=8443
PLESK_API_KEY=your_plesk_api_key_here
PLESK_USER=admin
PLESK_PASSWORD=your_plesk_password

# cPanel & WHM JSON API
CPANEL_HOST=cpanel.yourdomain.com
CPANEL_PORT=2087
CPANEL_USER=root
CPANEL_API_TOKEN=your_whm_api_token_here

# SmarterMail System API v1
SMARTERMAIL_HOST=mail.yourdomain.com
SMARTERMAIL_PORT=9998
SMARTERMAIL_API_TOKEN=your_smartermail_admin_bearer_token

# Proxmox VE Hypervisor API
PROXMOX_HOST=pve.yourdomain.com
PROXMOX_PORT=8006
PROXMOX_TOKEN_ID=root@pam!portal-token
PROXMOX_TOKEN_SECRET=your_proxmox_api_token_secret_uuid

# ------------------------------------------------------------------------------
# 4. Background Job Queue & Email Notifications (Redis + BullMQ)
# ------------------------------------------------------------------------------
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

# SMTP Email Dispatch
SMTP_HOST=smtp.yourmailserver.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@yourdomain.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="CloudPortal Support" <notifications@yourdomain.com>
